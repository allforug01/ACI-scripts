                  "pm.response.json().forEach(d => console.log(d.datacenter + '  |  ' + d.name));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/vcenter/datacenter",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "vcenter",
                "datacenter"
              ]
            },
            "description": "Lists datacenters."
          }
        },
        {
          "name": "U4 - Show VM NICs",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('vmId')) throw new Error('vmId is empty - run \"01 - Resolve VM\" (or the Move folder with dryRun=true) first.');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const base = pm.variables.get('baseUrl') + '/api/vcenter/vm/' + pm.environment.get('vmId') + '/hardware/ethernet/';",
                  "pm.response.json().forEach(n => pm.sendRequest({ url: base + n.nic, method: 'GET',",
                  "    header: [{ key: 'vmware-api-session-id', value: pm.environment.get('sessionId') }] }, (e, r) => {",
                  "    if (e || r.code !== 200) return console.error('NIC ' + n.nic + ': read failed');",
                  "    const d = r.json(), b = d.backing || {};",
                  "    console.log([n.nic, d.label, d.mac_address, b.type, b.network_name || '', b.network, d.state].join('  |  '));",
                  "}));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/vcenter/vm/{{vmId}}/hardware/ethernet",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "vcenter",
                "vm",
                "{{vmId}}",
                "hardware",
                "ethernet"
              ]
            },
            "description": "Prints label, MAC, backing and state of each NIC on `vmId`."
          }
